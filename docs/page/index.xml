            <description>&lt;div class=&#34;about-container&#34;&gt;&#xD;&#xA;&lt;!-- 个人名片卡片 --&gt;&#xD;&#xA;&lt;div class=&#34;about-card intro-card&#34;&gt;&#xD;&#xA;&lt;img src=&#34;https://starter.stack.cai.im/img/avatar.png&#34; class=&#34;about-avatar&#34; alt=&#34;Avatar&#34;&gt;&#xD;&#xA;&lt;div class=&#34;about-info&#34;&gt;&#xD;&#xA;&lt;h2&gt;你好，我是WIN-VSCODE&lt;/h2&gt;&#xD;&#xA;&lt;p&gt;2015年，一个喜欢把自己新奇古怪想法落地的人。想法有很多，落地又很少。这次搭建这个博客旨在记录一些自己学习或者生活上的事情。我写项目都是用AI的，&lt;strong&gt;包括这个网站&lt;/strong&gt;。&lt;/p&gt;&#xD;&#xA;&lt;div class=&#34;about-tags&#34;&gt;&#xD;&#xA;&lt;span&gt;Python 选手&lt;/span&gt;&#xD;&#xA;&lt;span&gt;AI 应用学习中...&lt;/span&gt;&#xD;&#xA;&lt;/div&gt;&#xD;&#xA;&lt;/div&gt;&#xD;&#xA;&lt;/div&gt;&#xD;&#xA;&lt;!-- 技术栈卡片 --&gt;&#xD;&#xA;&lt;div class=&#34;about-card&#34;&gt;&#xD;&#xA;&lt;h3&gt;⚙ 技术栈&lt;/h3&gt;&#xD;&#xA;&lt;div class=&#34;skill-group&#34;&gt;&#xD;&#xA;&lt;div class=&#34;skill-title&#34;&gt;后端 &lt;span class=&#34;badge&#34;&gt;主要开发方向&lt;/span&gt;&lt;/div&gt;&#xD;&#xA;&lt;div class=&#34;skill-tags&#34;&gt;&#xD;&#xA;&lt;span&gt;Python&lt;/span&gt;&lt;span&gt;C++&lt;/span&gt;&lt;span&gt;C&lt;/span&gt;&#xD;&#xA;&lt;/div&gt;&#xD;&#xA;&lt;/div&gt;&#xD;&#xA;&lt;div class=&#34;skill-group&#34;&gt;&#xD;&#xA;&lt;div class=&#34;skill-title&#34;&gt;前端 &lt;span class=&#34;badge&#34;&gt;能写能改&lt;/span&gt;&lt;/div&gt;&#xD;&#xA;&lt;div class=&#34;skill-tags&#34;&gt;&#xD;&#xA;&gt;&lt;span&gt;JavaScript&lt;/span&gt;&lt;span&gt;HTML / CSS&lt;/span&gt;&#xD;&#xA;&lt;/div&gt;&#xD;&#xA;&lt;/div&gt;&#xD;&#xA;&lt;div class=&#34;skill-group&#34;&gt;&#xD;&#xA;&lt;div class=&#34;skill-title&#34;&gt;工具 &amp; 部署 &lt;span class=&#34;badge&#34;&gt;日常使用&lt;/span&gt;&lt;/div&gt;&#xD;&#xA;&lt;div class=&#34;skill-tags&#34;&gt;&#xD;&#xA;&lt;span&gt;Windows &amp; Linux&lt;/span&gt;&lt;span&gt;Git&lt;/span&gt;&lt;span&gt;DeepSeek网页版&lt;/span&gt;&#xD;&#xA;&lt;/div&gt;&#xD;&#xA;&lt;/div&gt;&#xD;&#xA;&lt;/div&gt;&#xD;&#xA;&lt;!-- 所在地卡片 --&gt;&#xD;&#xA;&lt;div class=&#34;about-card&#34;&gt;&#xD;&#xA;&lt;h3&gt;📍 所在地&lt;/h3&gt;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&lt;link rel=&#34;stylesheet&#34; href=&#34;https://unpkg.com/leaflet@1.9.4/dist/leaflet.css&#34; /&gt;&#xD;&#xA;&lt;script src=&#34;https://unpkg.com/leaflet@1.9.4/dist/leaflet.js&#34;&gt;&lt;/script&gt;&#xD;&#xA;&#xD;&#xA;&lt;div id=&#34;about-map&#34; style=&#34;height: 400px; width: 100%; border-radius: 12px; z-index: 1;&#34;&gt;&lt;/div&gt;&#xD;&#xA;&#xD;&#xA;&lt;script&gt;&#xD;&#xA;  document.addEventListener(&#39;DOMContentLoaded&#39;, function() {&#xD;&#xA;    var map = L.map(&#39;about-map&#39;).setView([&#34;29.71&#34;, &#34;118.31&#34;], &#34;12&#34;);&#xD;&#xA;    &#xD;&#xA;    &#xD;&#xA;    L.tileLayer(&#39;https://webrd0{s}.is.autonavi.com/appmaptile?lang=zh_cn&amp;size=1&amp;scale=1&amp;style=8&amp;x={x}&amp;y={y}&amp;z={z}&#39;, {&#xD;&#xA;      subdomains: [&#39;1&#39;, &#39;2&#39;, &#39;3&#39;, &#39;4&#39;],&#xD;&#xA;      attribution: &#39;© 高德地图&#39;&#xD;&#xA;    }).addTo(map);&#xD;&#xA;&#xD;&#xA;    &#xD;&#xA;    L.marker([&#34;29.71&#34;, &#34;118.31&#34;]).addTo(map)&#xD;&#xA;      .bindPopup(&#39;安徽·黄山&#39;)&#xD;&#xA;      .openPopup();&#xD;&#xA;  });&#xD;&#xA;&lt;/script&gt;&#xD;&#xA;&lt;p class=&#34;map-text&#34;&gt;Currently Living: 安徽·黄山&lt;/p&gt;&#xD;&#xA;&lt;/div&gt;&#xD;&#xA;&lt;/div&gt;</description>
